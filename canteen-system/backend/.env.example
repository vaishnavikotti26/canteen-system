# Copy this file to ".env" and edit the values
PORT=5000
# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/college_canteen
# MongoDB Atlas example:
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/college_canteen?retryWrites=true&w=majority
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Used by "npm run seed" to create the first admin account
ADMIN_NAME=Canteen Admin
ADMIN_EMAIL=admin@srkr.edu
ADMIN_PASSWORD=Admin@123
